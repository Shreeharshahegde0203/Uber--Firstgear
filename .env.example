# 🔐 Environment Configuration Template
# 
# Instructions:
# 1. Copy this file and rename it to ".env" (remove .example)
# 2. Replace YOUR_PASSWORD_HERE with your actual PostgreSQL password
# 3. DO NOT commit the .env file to Git!

# ⚠️ REQUIRED: Database Connection
# Format: postgresql://username:password@host:port/database_name
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD_HERE@localhost:5432/uberclon

# Optional: API Configuration
API_KEY=your_secret_key_change_in_production

# Optional: Development Mode
DEBUG=True

# Optional: Server Configuration
HOST=0.0.0.0
PORT=8000

# Optional: Logging
LOG_LEVEL=INFO

# ────────────────────────────────────────────────────────────────
# EXAMPLES:
# ────────────────────────────────────────────────────────────────
#
# Example 1: Default PostgreSQL installation
# DATABASE_URL=postgresql://postgres:mypassword123@localhost:5432/uberclon
#
# Example 2: Custom PostgreSQL user
# DATABASE_URL=postgresql://myuser:mypassword@localhost:5432/uberclon
#
# Example 3: Remote database server
# DATABASE_URL=postgresql://postgres:password@192.168.1.100:5432/uberclon
#
# Example 4: Different database name
# DATABASE_URL=postgresql://postgres:password@localhost:5432/uber_app
#
# ────────────────────────────────────────────────────────────────

# 📝 NOTES:
# - If PostgreSQL is on your computer, use "localhost"
# - Default PostgreSQL port is 5432
# - Default PostgreSQL username is "postgres"
# - Password was set during PostgreSQL installation
# - Create database using: CREATE DATABASE uberclon;
